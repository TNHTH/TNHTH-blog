{
  "name": "tnhth-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build:astro": "astro build",
    "search:index": "pagefind --site dist",
    "build:site": "pnpm build:astro && pnpm search:index",
    "build": "pnpm content:verify && pnpm build:site",
    "start": "node scripts/serve-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "publisher": "tsx scripts/publisher.ts",
    "content:verify": "tsx scripts/validate-public.ts --snapshot",
    "audit:public": "tsx scripts/validate-public.ts --snapshot",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "verify": "pnpm check && pnpm test",
    "test:e2e": "playwright test",
    "ci": "pnpm verify && pnpm build && pnpm test:e2e",
    "build:sites": "pnpm build && node scripts/prepare-sites-runtime.mjs",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^6.0.0",
    "d3-force": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-force": "^3.0.10",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
