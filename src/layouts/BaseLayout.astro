---
import "../styles/global.css";
import { site } from "../../config/site";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: ImageMetadata | string;
  ogImageAlt?: string;
}

const { title = site.brand, description = site.description, noindex = false, ogImage, ogImageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const resolveOgImage = async (): Promise<{ url: string; width?: number; height?: number }> => {
  if (!ogImage) return { url: new URL("/og-default.png", Astro.site ?? Astro.url.origin).toString(), width: 1200, height: 630 };
  if (typeof ogImage === "string") return { url: new URL(ogImage, Astro.site ?? Astro.url.origin).toString() };
  const optimized = await getImage({ src: ogImage, width: 1200 });
  return { url: new URL(optimized.src, Astro.site ?? Astro.url.origin).toString(), width: optimized.attributes.width as number, height: optimized.attributes.height as number };
};
const resolvedOgImage = await resolveOgImage();
const resolvedOgImageAlt = ogImageAlt ?? description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var key = "tnhth-theme";
        var stored = null;
        try { stored = localStorage.getItem(key); } catch (error) {}
        var theme = stored === "dark" || stored === "light" ? stored : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") document.documentElement.dataset.theme = "dark";
        document.addEventListener("DOMContentLoaded", function () {
          var button = document.querySelector("#theme-toggle");
          if (!button) return;
          button.addEventListener("click", function () {
            var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem(key, next); } catch (error) {}
          });
        });
      })();
    </script>
    {noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    {noindex && <meta name="referrer" content="no-referrer" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage.url} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    {resolvedOgImage.width && <meta property="og:image:width" content={String(resolvedOgImage.width)} />}
    {resolvedOgImage.height && <meta property="og:image:height" content={String(resolvedOgImage.height)} />}
    <title>{title} · {site.brand}</title>
  </head>
  <body class="m-0">
    <header data-pagefind-ignore class="site-shell mx-auto flex items-center justify-between py-5 md:py-6">
      <a class="focus-ring display text-xl" href="/"><span data-profile="brand">{site.brand}</span><span class="accent">.</span></a>
      <nav aria-label="主导航" class="hidden gap-6 text-sm md:flex">
        {site.nav.map((item) => <a class="focus-ring" href={item.href}>{item.label}</a>)}
      </nav>
      <details class="relative md:hidden">
        <summary class="focus-ring cursor-pointer list-none p-2 text-sm">菜单</summary>
        <nav aria-label="移动端导航" class="absolute right-0 z-10 grid min-w-40 gap-3 border border-[var(--line)] bg-[var(--paper)] p-4 text-sm shadow-lg">
          {site.nav.map((item) => <a class="focus-ring" href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <button id="theme-toggle" class="focus-ring border-0 bg-transparent p-2 text-sm" type="button" aria-label="切换明暗主题">◐</button>
    </header>
    <main data-pagefind-body><slot /></main>
    <footer data-pagefind-ignore class="site-shell mx-auto rule mt-24 flex flex-col gap-5 py-8 text-xs md:flex-row md:items-center md:justify-between">
      <span class="muted">© {new Date().getFullYear()} <span data-profile="name">{site.name}</span> · <span data-profile="brand">{site.brand}</span></span>
      <div class="flex gap-5 text-sm">
        <a class="focus-ring" href={site.github} data-profile-href="github" aria-label="GitHub · TNHTH-blog 本站源码">GitHub → 本站源码</a>
        {site.email && <a class="focus-ring" href={`mailto:${site.email}`}>邮箱 →</a>}
      </div>
    </footer>
  </body>
</html>
