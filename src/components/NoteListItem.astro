---
import type { NoteEntry } from "../lib/content";
interface Props { note: NoteEntry; }
const { note } = Astro.props;
---
<a class="note-card focus-ring group block" href={`/notes/${note.id}`} data-search-item data-search-text={`${note.data.title} ${note.data.summary ?? ""} ${note.data.tags.join(" ")}`} data-search-tags={note.data.tags.join(",")}>
  <time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}</time>
  <h2 class="display transition-transform duration-300 group-hover:translate-x-1">{note.data.title}</h2>
  {note.data.tags.length > 0 && <div class="note-card-tags">{note.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}</div>}
</a>
