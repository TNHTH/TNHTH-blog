---
import type { NoteEntry } from "../lib/content";
interface Props { note: NoteEntry; }
const { note } = Astro.props;
---
<a class="note-list-item focus-ring group" href={`/notes/${note.id}`} data-search-item data-search-text={`${note.data.title} ${note.data.summary ?? ""} ${note.data.tags.join(" ")}`}>
  <time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}</time>
  <div><h2 class="display m-0 text-2xl transition-transform duration-300 group-hover:translate-x-1">{note.data.title}</h2>{note.data.summary && <p class="muted mt-2 leading-7">{note.data.summary}</p>}<div class="mt-3 flex flex-wrap gap-2">{note.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div>
</a>
