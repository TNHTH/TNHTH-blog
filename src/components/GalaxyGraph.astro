---
import type { GalaxyEdge, GalaxyNode } from "../lib/content";

interface Props {
  nodes: GalaxyNode[];
  edges: GalaxyEdge[];
}

const { nodes, edges } = Astro.props;
const nodeRadius = (kind: GalaxyNode["kind"]) => kind === "project" ? 2.3 : kind === "topic" ? 1.55 : kind === "center" ? 2.9 : 1.05;
---

<div class="galaxy" data-galaxy data-graph-mode="quiet">
  <div class="sr-only" data-graph-status aria-live="polite">关系图处于安静模式</div>
  <svg viewBox="0 0 100 100" role="img" aria-label="内容关系图" aria-describedby="galaxy-desc">
    <desc id="galaxy-desc">项目、笔记和主题组成的可拖动关系图。拖动节点或空白区域可以探索关系，普通页面链接仍然提供完整内容入口。</desc>
    <rect class="galaxy-backdrop" x="0" y="0" width="100" height="100" aria-hidden="true" />
    <g class="galaxy-stage" data-galaxy-stage>
      <g data-galaxy-ripples aria-hidden="true"></g>
      {edges.map((edge) => {
        const source = nodes.find((node) => node.id === edge.source);
        const target = nodes.find((node) => node.id === edge.target);
        return source && target ? <line class={`galaxy-edge galaxy-edge-${edge.kind}`} data-source={edge.source} data-target={edge.target} data-edge-kind={edge.kind} x1={source.x} y1={source.y} x2={target.x} y2={target.y} /> : null;
      })}
      {nodes.map((node) => node.href ? (
        <g class={`galaxy-node galaxy-node-${node.kind}`} data-node-id={node.id} data-node-kind={node.kind} data-node-x={node.x} data-node-y={node.y} transform={`translate(${node.x} ${node.y})`}>
          <a href={node.href} aria-label={node.label} tabindex="0">
            <circle cx="0" cy="0" r={nodeRadius(node.kind)} />
            <text x={nodeRadius(node.kind) + 2} y="-1">{node.label}</text>
          </a>
        </g>
      ) : (
        <g class={`galaxy-node galaxy-node-${node.kind}`} data-node-id={node.id} data-node-kind={node.kind} data-node-x={node.x} data-node-y={node.y} aria-hidden="true" transform={`translate(${node.x} ${node.y})`}>
          {node.kind === "center" ? <><circle class="galaxy-center-ring" cx="0" cy="0" r={nodeRadius(node.kind) + 2} /><circle class="galaxy-center-ring galaxy-center-ring-delayed" cx="0" cy="0" r={nodeRadius(node.kind) + 2} /></> : null}
          <circle cx="0" cy="0" r={nodeRadius(node.kind)} />
          <text x={nodeRadius(node.kind) + 2} y="-1">{node.label}</text>
        </g>
      ))}
    </g>
  </svg>
</div>

<script>
  import { forceCenter, forceCollide, forceLink, forceManyBody, forceSimulation, type SimulationLinkDatum, type SimulationNodeDatum } from "d3-force";
  import { GALAXY_LAYOUT } from "../lib/galaxy-layout";

  type GalaxySimulationNode = SimulationNodeDatum & { id: string; kind: string; x: number; y: number; homeX: number; homeY: number };
  type GalaxySimulationLink = SimulationLinkDatum<GalaxySimulationNode> & { source: string | GalaxySimulationNode; target: string | GalaxySimulationNode };

  const root = document.querySelector<HTMLElement>("[data-galaxy]");
  const hero = root?.closest<HTMLElement>(".home-hero");
  const svg = root?.querySelector<SVGSVGElement>("svg");
  const stage = root?.querySelector<SVGGElement>("[data-galaxy-stage]");
  const rippleLayer = root?.querySelector<SVGGElement>("[data-galaxy-ripples]");
  const status = root?.querySelector<HTMLElement>("[data-graph-status]");
  const nodeElements = [...(root?.querySelectorAll<SVGGElement>(".galaxy-node[data-node-id]") ?? [])];
  const edgeElements = [...(root?.querySelectorAll<SVGLineElement>(".galaxy-edge") ?? [])];
  const elementById = new Map(nodeElements.map((element) => [element.dataset.nodeId ?? "", element]));

  if (root && svg && stage && rippleLayer) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const initialNodes = nodeElements.map((element) => ({
      id: element.dataset.nodeId ?? "",
      kind: element.dataset.nodeKind ?? "note",
      x: Number(element.dataset.nodeX ?? 50),
      y: Number(element.dataset.nodeY ?? 50),
      homeX: Number(element.dataset.nodeX ?? 50),
      homeY: Number(element.dataset.nodeY ?? 50),
    })) as GalaxySimulationNode[];
    const links = edgeElements.map((element) => ({
      source: element.dataset.source ?? "",
      target: element.dataset.target ?? "",
    })) as GalaxySimulationLink[];
    const byId = new Map(initialNodes.map((node) => [node.id, node]));
    const view = { x: 0, y: 0, k: 1 };
    let drag: { kind: "node" | "pan"; id?: string; pointerId: number; lastX: number; lastY: number; moved: boolean } | null = null;
    let suppressClick = false;
    let restoreTimer: number | undefined;
    let restoreRaf: number | undefined;
    let panRaf: number | undefined;
    let pendingPan: { dx: number; dy: number } | null = null;
    let homeStrength = reducedMotion ? 0 : .012;
    let restoring = false;
    let restoreStartedAt = 0;

    const radiusByKind: Record<string, number> = { project: 2.3, topic: 1.55, center: 2.9, note: 1.05 };
    const homeForce = () => {
      let simulationNodes: GalaxySimulationNode[] = [];
      const force = (alpha: number) => {
        for (const node of simulationNodes) {
          const strength = homeStrength * alpha;
          node.vx = (node.vx ?? 0) + (node.homeX - node.x) * strength;
          node.vy = (node.vy ?? 0) + (node.homeY - node.y) * strength;
        }
      };
      force.initialize = (nextNodes: GalaxySimulationNode[]) => { simulationNodes = nextNodes; };
      return force;
    };

    const simulation = forceSimulation<GalaxySimulationNode>(initialNodes)
      .force("link", forceLink<GalaxySimulationNode, GalaxySimulationLink>(links).id((node) => node.id).distance((link) => typeof link.source === "string" || typeof link.source === "number" ? 13 : link.source.kind === "center" ? 19 : 13).strength(.5))
      .force("charge", forceManyBody().strength(-17))
      .force("collide", forceCollide<GalaxySimulationNode>().radius((node) => node.kind === "project" ? 5 : node.kind === "center" ? 4 : 3.1).strength(.9))
      .force("center", forceCenter(GALAXY_LAYOUT.centerX, GALAXY_LAYOUT.centerY).strength(.16))
      .force("home", homeForce())
      .alphaDecay(.035)
      .alphaTarget(0)
      .stop();

    const setView = () => stage.setAttribute("transform", `translate(${view.x} ${view.y}) scale(${view.k})`);
    const setStatus = (message: string) => { if (status) status.textContent = message; };
    const rawPoint = (event: PointerEvent | WheelEvent) => {
      const matrix = svg.getScreenCTM();
      if (!matrix) return { x: GALAXY_LAYOUT.centerX, y: GALAXY_LAYOUT.centerY };
      const point = svg.createSVGPoint();
      point.x = event.clientX;
      point.y = event.clientY;
      const local = point.matrixTransform(matrix.inverse());
      return { x: local.x, y: local.y };
    };
    const screenDeltaToSvg = (dx: number, dy: number) => {
      const matrix = svg.getScreenCTM();
      if (!matrix) return { x: 0, y: 0 };
      const from = svg.createSVGPoint();
      from.x = 0;
      from.y = 0;
      const to = svg.createSVGPoint();
      to.x = dx;
      to.y = dy;
      const inverse = matrix.inverse();
      const fromLocal = from.matrixTransform(inverse);
      const toLocal = to.matrixTransform(inverse);
      return { x: toLocal.x - fromLocal.x, y: toLocal.y - fromLocal.y };
    };
    const graphPoint = (event: PointerEvent | WheelEvent) => {
      const point = rawPoint(event);
      return { x: (point.x - view.x) / view.k, y: (point.y - view.y) / view.k };
    };
    type LabelSide = "left" | "right" | "top" | "bottom";
    type LabelBox = { left: number; right: number; top: number; bottom: number };
    const labelBox = (node: GalaxySimulationNode, label: SVGTextElement): LabelBox => {
      const box = label.getBBox();
      return { left: node.x + box.x, right: node.x + box.x + box.width, top: node.y + box.y, bottom: node.y + box.y + box.height };
    };
    const boxesOverlap = (first: LabelBox, second: LabelBox) => first.left < second.right && first.right > second.left && first.top < second.bottom && first.bottom > second.top;
    const centerSafeBox = (): LabelBox | null => {
      const center = byId.get("center");
      if (!center) return null;
      const radius = radiusByKind.center + 2;
      return { left: center.x - radius, right: center.x + radius, top: center.y - radius, bottom: center.y + radius };
    };
    const centerLabelBox = (): LabelBox | null => {
      const center = byId.get("center");
      const element = center ? elementById.get(center.id) : undefined;
      const label = element?.querySelector<SVGTextElement>("text");
      return center && label ? labelBox(center, label) : null;
    };
    const setLabelSide = (node: GalaxySimulationNode, label: SVGTextElement, side: LabelSide) => {
      const offset = (radiusByKind[node.kind] ?? 1.05) + 2;
      if (side === "left") {
        label.setAttribute("x", String(-offset));
        label.setAttribute("y", "-1");
        label.setAttribute("text-anchor", "end");
      } else if (side === "right") {
        label.setAttribute("x", String(offset));
        label.setAttribute("y", "-1");
        label.setAttribute("text-anchor", "start");
      } else if (side === "top") {
        label.setAttribute("x", "0");
        label.setAttribute("y", String(-(offset + 2)));
        label.setAttribute("text-anchor", "middle");
      } else {
        label.setAttribute("x", "0");
        label.setAttribute("y", String(offset + 4));
        label.setAttribute("text-anchor", "middle");
      }
    };
    const placeLabel = (node: GalaxySimulationNode, label: SVGTextElement) => {
      const horizontal = node.x < GALAXY_LAYOUT.centerX ? "left" : "right";
      const oppositeHorizontal = horizontal === "left" ? "right" : "left";
      const vertical = node.y < GALAXY_LAYOUT.centerY ? "top" : "bottom";
      const oppositeVertical = vertical === "top" ? "bottom" : "top";
      const candidates: LabelSide[] = [horizontal, oppositeHorizontal, vertical, oppositeVertical];
      const centerSafe = node.kind === "center" ? null : centerSafeBox();
      const centerText = node.kind === "center" ? null : centerLabelBox();
      let bestSide = candidates[0];
      let bestScore = Number.POSITIVE_INFINITY;

      for (const side of candidates) {
        setLabelSide(node, label, side);
        const box = labelBox(node, label);
        const overflow = Math.max(0, 2 - box.left) + Math.max(0, box.right - 98) + Math.max(0, 2 - box.top) + Math.max(0, box.bottom - 98);
        const centerOverlap = centerSafe && boxesOverlap(box, centerSafe) ? 100 : 0;
        const centerTextOverlap = centerText && boxesOverlap(box, centerText) ? 50 : 0;
        const score = overflow + centerOverlap + centerTextOverlap;
        if (score < bestScore) {
          bestScore = score;
          bestSide = side;
        }
        if (overflow === 0 && centerOverlap === 0 && centerTextOverlap === 0) return;
      }

      setLabelSide(node, label, bestSide);
    };
    const render = () => {
      initialNodes.forEach((node) => {
        const element = elementById.get(node.id);
        if (!element) return;
        element.setAttribute("transform", `translate(${node.x} ${node.y})`);
        const label = element.querySelector("text");
        if (label) placeLabel(node, label);
      });
      links.forEach((link, index) => {
        const source = typeof link.source === "string" ? byId.get(link.source) : link.source;
        const target = typeof link.target === "string" ? byId.get(link.target) : link.target;
        const element = edgeElements[index];
        if (!source || !target || !element) return;
        element.setAttribute("x1", String(source.x));
        element.setAttribute("y1", String(source.y));
        element.setAttribute("x2", String(target.x));
        element.setAttribute("y2", String(target.y));
      });
      setView();
    };
    const neighborsOf = (id: string) => new Set([id, ...links.flatMap((link) => {
      const source = typeof link.source === "string" ? link.source : link.source.id;
      const target = typeof link.target === "string" ? link.target : link.target.id;
      return source === id ? [target] : target === id ? [source] : [];
    })]);
    const setFocus = (id: string | null) => {
      const neighbors = id ? neighborsOf(id) : new Set<string>();
      nodeElements.forEach((element) => {
        const nodeId = element.dataset.nodeId ?? "";
        const isMuted = Boolean(id && !neighbors.has(nodeId));
        element.classList.toggle("is-active", nodeId === id);
        element.classList.toggle("is-muted", isMuted);
        const text = element.querySelector("text");
        if (text) text.setAttribute("style", `--label-opacity: ${nodeId === id ? ".98" : nodeId === "center" ? ".82" : "0"}`);
      });
      edgeElements.forEach((element) => {
        const isNear = Boolean(id && (element.dataset.source === id || element.dataset.target === id));
        element.classList.toggle("is-near", isNear);
        element.classList.toggle("is-muted", Boolean(id && !isNear));
      });
    };
    const ripple = (point: { x: number; y: number }) => {
      if (reducedMotion) return;
      for (let index = 0; index < 4; index += 1) {
        const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("class", "galaxy-ripple");
        circle.setAttribute("cx", String(point.x));
        circle.setAttribute("cy", String(point.y));
        circle.setAttribute("r", "2");
        rippleLayer.append(circle);
        const start = performance.now() + index * 240;
        const animate = (now: number) => {
          const progress = Math.min(1, Math.max(0, (now - start) / 900));
          if (progress === 0) { requestAnimationFrame(animate); return; }
          circle.setAttribute("r", String(2 + progress * 16));
          circle.style.opacity = String((1 - progress) * .48);
          if (progress < 1) requestAnimationFrame(animate); else circle.remove();
        };
        requestAnimationFrame(animate);
      }
    };
    const finishRestore = () => {
      window.clearTimeout(restoreTimer);
      restoreTimer = undefined;
      if (restoreRaf !== undefined) {
        window.cancelAnimationFrame(restoreRaf);
        restoreRaf = undefined;
      }
      restoring = false;
      restoreNodes();
      view.x = 0;
      view.y = 0;
      view.k = 1;
      setView();
      homeStrength = reducedMotion ? 0 : .012;
      simulation.alphaTarget(0);
      simulation.stop();
      hero?.classList.remove("is-exploring");
      root.dataset.graphMode = "quiet";
      setStatus("关系图处于安静模式");
    };
    const cancelRestore = () => {
      window.clearTimeout(restoreTimer);
      if (restoreRaf !== undefined) window.cancelAnimationFrame(restoreRaf);
      restoreRaf = undefined;
      restoring = false;
      homeStrength = reducedMotion ? 0 : .012;
    };
    const enterExplore = () => {
      cancelRestore();
      hero?.classList.add("is-exploring");
      root.dataset.graphMode = "explore";
      setStatus("关系图处于探索模式。拖动节点或空白区域，滚轮可以缩放。松手后自动恢复。");
    };
    const restoreView = () => {
      const from = { ...view };
      const startedAt = performance.now();
      const animate = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / 360);
        const eased = 1 - Math.pow(1 - progress, 3);
        view.x = from.x * (1 - eased);
        view.y = from.y * (1 - eased);
        view.k = from.k + (1 - from.k) * eased;
        setView();
        if (progress < 1) {
          restoreRaf = window.requestAnimationFrame(animate);
          return;
        }
        restoreRaf = undefined;
        view.x = 0; view.y = 0; view.k = 1;
        setView();
        restoreRaf = undefined;
      };
      restoreRaf = window.requestAnimationFrame(animate);
    };
    const restoreNodes = () => {
      for (const node of initialNodes) {
        node.fx = null;
        node.fy = null;
        node.vx = 0;
        node.vy = 0;
        node.x = node.homeX;
        node.y = node.homeY;
      }
      render();
    };
    const startRestore = () => {
      cancelRestore();
      restoring = true;
      restoreStartedAt = performance.now();
      hero?.classList.remove("is-exploring");
      root.dataset.graphMode = "restoring";
      setStatus("关系图正在恢复默认布局");
      if (reducedMotion) {
        restoreNodes();
        view.x = 0;
        view.y = 0;
        view.k = 1;
        setView();
        finishRestore();
        return;
      }
      homeStrength = .22;
      simulation.alpha(.55).alphaTarget(.08).restart();
      restoreView();
      const waitForRestore = () => {
        if (!restoring) return;
        const settled = initialNodes.every((node) => Math.hypot(node.x - node.homeX, node.y - node.homeY) < .8 && Math.hypot(node.vx ?? 0, node.vy ?? 0) < .2);
        if (settled || performance.now() - restoreStartedAt > 1300) {
          finishRestore();
          return;
        }
        window.requestAnimationFrame(waitForRestore);
      };
      window.requestAnimationFrame(waitForRestore);
    };
    const scheduleRestore = () => {
      window.clearTimeout(restoreTimer);
      restoreTimer = window.setTimeout(() => { if (!drag) startRestore(); }, 160);
    };
    const resetView = () => {
      startRestore();
    };
    const flushPan = () => {
      panRaf = undefined;
      if (!pendingPan) return;
      const delta = screenDeltaToSvg(pendingPan.dx, pendingPan.dy);
      view.x += delta.x;
      view.y += delta.y;
      pendingPan = null;
      setView();
    };
    const queuePan = (dx: number, dy: number) => {
      pendingPan = pendingPan ? { dx: pendingPan.dx + dx, dy: pendingPan.dy + dy } : { dx, dy };
      if (panRaf === undefined) panRaf = window.requestAnimationFrame(flushPan);
    };

    simulation.on("tick", render);
    render();

    svg.addEventListener("pointerdown", (event) => {
      const pointer = event as PointerEvent;
      const target = (pointer.target as Element | null)?.closest<SVGGElement>(".galaxy-node[data-node-id]");
      if (target) {
        const node = byId.get(target.dataset.nodeId ?? "");
        if (!node) return;
        drag = { kind: "node", id: node.id, pointerId: pointer.pointerId, lastX: pointer.clientX, lastY: pointer.clientY, moved: false };
        node.fx = node.x; node.fy = node.y;
        simulation.alphaTarget(.32).restart();
        ripple({ x: node.x, y: node.y });
      } else {
        drag = { kind: "pan", pointerId: pointer.pointerId, lastX: pointer.clientX, lastY: pointer.clientY, moved: false };
        pendingPan = null;
      }
      enterExplore();
      svg.setPointerCapture(pointer.pointerId);
    });
    svg.addEventListener("pointermove", (event) => {
      const pointer = event as PointerEvent;
      if (drag) {
        const dx = pointer.clientX - drag.lastX;
        const dy = pointer.clientY - drag.lastY;
        if (Math.hypot(dx, dy) > 2) drag.moved = true;
        if (drag.kind === "node" && drag.id) {
          const node = byId.get(drag.id);
          if (node) {
            const point = graphPoint(pointer);
            node.fx = point.x; node.fy = point.y;
            render();
          }
        } else {
          queuePan(dx, dy);
        }
        drag.lastX = pointer.clientX; drag.lastY = pointer.clientY;
      }
    });
    const finishPointer = (event: Event) => {
      if (!drag) return;
      const completed = drag;
      drag = null;
      if (completed.kind === "pan") {
        if (panRaf !== undefined) window.cancelAnimationFrame(panRaf);
        flushPan();
      }
      if (completed.kind === "node" && completed.id) {
        const node = byId.get(completed.id);
        if (node) { node.fx = null; node.fy = null; ripple({ x: node.x, y: node.y }); }
        homeStrength = reducedMotion ? 0 : .22;
        simulation.alpha(.55).alphaTarget(.08).restart();
      }
      if (completed.moved) suppressClick = true;
      window.setTimeout(() => { suppressClick = false; }, 80);
      if (svg.hasPointerCapture((event as PointerEvent).pointerId)) svg.releasePointerCapture((event as PointerEvent).pointerId);
      scheduleRestore();
    };
    svg.addEventListener("pointerup", finishPointer);
    svg.addEventListener("pointercancel", finishPointer);
    svg.addEventListener("pointerleave", () => { if (!drag) setFocus(null); });
    svg.addEventListener("wheel", (event) => {
      const wheel = event as WheelEvent;
      wheel.preventDefault();
      const point = rawPoint(wheel);
      const before = graphPoint(wheel);
      view.k = Math.min(2.8, Math.max(.72, view.k * Math.exp(-wheel.deltaY * .001)));
      view.x = point.x - before.x * view.k;
      view.y = point.y - before.y * view.k;
      setView();
      enterExplore();
      scheduleRestore();
    }, { passive: false });
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.dataset.graphMode === "explore") resetView();
    });
    nodeElements.forEach((element) => {
      const link = element.querySelector<HTMLAnchorElement>("a");
      element.addEventListener("pointerenter", () => setFocus(element.dataset.nodeId ?? null));
      link?.addEventListener("focus", () => setFocus(element.dataset.nodeId ?? null));
      link?.addEventListener("blur", () => setFocus(null));
      link?.addEventListener("click", (event) => {
        if (suppressClick) { event.preventDefault(); return; }
        event.preventDefault();
        const id = element.dataset.nodeId ?? null;
        setFocus(id);
        const node = byId.get(id ?? "");
        if (node) ripple({ x: node.x, y: node.y });
        const href = link.href;
        window.setTimeout(() => window.location.assign(href), reducedMotion ? 0 : 180);
      });
    });
  }
</script>
