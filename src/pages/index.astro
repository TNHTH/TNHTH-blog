---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import GalaxyGraph from "../components/GalaxyGraph.astro";
import NoteListItem from "../components/NoteListItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { assertContentRelationships, buildGalaxyModel, sortNotes, sortProjects } from "../lib/content";
import { getCollection } from "astro:content";
import { site } from "../../config/site";

const projects = sortProjects(await getCollection("projects"));
const notes = sortNotes(await getCollection("notes"));
assertContentRelationships(projects, notes);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const latestNotes = notes.slice(0, 4);
const galaxy = buildGalaxyModel(projects, notes);
---

<BaseLayout>
  <main>
    <section class="site-shell home-hero mx-auto">
      <div class="home-hero-galaxy" aria-label="项目、笔记和主题的关系图">
        {projects.length || notes.length ? <GalaxyGraph nodes={galaxy.nodes} edges={galaxy.edges} /> : <EmptyState title="当前暂无公开内容" description="项目和笔记发布后，关系图会在这里出现。" />}
      </div>
      <div class="home-hero-copy">
        <div class="eyebrow mb-5">{site.location}</div>
        <h1 class="display home-hero-name m-0">{site.heroTitle}</h1>
        <p class="home-hero-description mt-7">{site.heroDescription}</p>
        <p class="home-hero-meta mt-7 m-0">{site.practice?.join(" / ")}</p>
      </div>
    </section>

    <section class="site-shell home-section mx-auto" aria-labelledby="short-about">
      <div class="grid gap-6 md:grid-cols-[1fr_2fr]">
        <div class="eyebrow">关于</div>
        <p id="short-about" class="short-about m-0">喜欢从一个具体的问题出发，把概念弄明白，把东西真正做出来，再把过程中值得留下的内容记录下来。</p>
      </div>
    </section>

    <section class="site-shell home-section mx-auto" aria-labelledby="featured-projects">
      <div class="mb-6 flex items-end justify-between gap-4"><div><div class="eyebrow">项目</div><h2 id="featured-projects" class="display mt-3 text-4xl md:text-5xl">精选项目</h2></div><a class="focus-ring text-sm" href="/projects">全部项目 →</a></div>
      {featuredProjects.length ? <div class="grid gap-5 md:grid-cols-3">{featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}</div> : <EmptyState title="当前暂无公开项目" />}
    </section>

    <section class="site-shell home-section mx-auto" aria-labelledby="latest-notes">
      <div class="mb-6 flex items-end justify-between gap-4"><div><div class="eyebrow">笔记</div><h2 id="latest-notes" class="display mt-3 text-4xl md:text-5xl">最近笔记</h2></div><a class="focus-ring text-sm" href="/notes">全部笔记 →</a></div>
      {latestNotes.length ? <div class="grid gap-0 md:grid-cols-2 md:gap-x-10">{latestNotes.map((note) => <NoteListItem note={note} />)}</div> : <EmptyState title="当前暂无公开笔记" />}
    </section>
  </main>
</BaseLayout>
