---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { site } from "../../config/site";
import { getCollection } from "astro:content";
const projects = (await getCollection("work")).filter(({ data }) => data.featured).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="site-shell mx-auto grid gap-12 pb-16 pt-14 md:grid-cols-[1fr_280px] md:pb-28 md:pt-24">
    <div>
      <div class="eyebrow mb-6">{site.location} · {site.headline}</div>
      <h1 class="display max-w-4xl text-6xl leading-[.92] md:text-8xl">Building systems that <span class="accent">sense</span>, learn, and act.</h1>
      <p class="muted mt-8 max-w-xl text-base leading-8">A public notebook of robotics projects, reinforcement-learning experiments, and the engineering decisions behind them.</p>
      <a class="focus-ring mt-10 inline-flex items-center gap-4 border-b-2 border-[var(--signal)] pb-2 text-sm font-semibold uppercase tracking-[.12em]" href="/work">Explore selected work <span>↘</span></a>
    </div>
    <div class="self-end border-l border-[var(--line)] pl-6 text-sm leading-7 md:mb-3"><div class="eyebrow mb-4">Now</div><p class="m-0">Robotics systems<br />Reinforcement learning<br />Embodied intelligence</p></div>
  </section>
  <section class="site-shell mx-auto" aria-labelledby="selected-work">
    <div class="mb-2 flex items-end justify-between"><div class="eyebrow" id="selected-work">Selected work</div><span class="muted text-xs">2025—2026</span></div>
    {projects.length ? projects.map((project, index) => <ProjectRow index={`0${index + 1}`} title={project.data.title} summary={project.data.summary} status={project.data.status} tags={project.data.tags} href={`/work/${project.id}`} />) : <div class="rule py-10 muted">Public work is being reviewed and prepared.</div>}
  </section>
  <section class="site-shell mx-auto mt-24 grid gap-8 border-t border-[var(--line)] pt-8 md:grid-cols-[1fr_2fr]"><div class="eyebrow">A living archive</div><div><p class="display m-0 max-w-3xl text-4xl leading-tight md:text-5xl">The site is the edited layer. The vault stays private.</p><a class="focus-ring mt-7 inline-block text-sm font-semibold uppercase tracking-[.12em]" href="/about">Read the boundary ↗</a></div></section>
</BaseLayout>
