---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
---
<BaseLayout title="Gallery"><section class="site-shell mx-auto pt-16 md:pt-24"><SectionHeading eyebrow="04 / Gallery" title="Images in progress" intro="A quiet archive for photographs and visual experiments. Only owned, reviewed, and metadata-clean media will appear here." /><div class="grid min-h-[360px] place-items-center border-y border-[var(--line)] py-20 text-center"><div><div class="display text-5xl">The first series is being reviewed.</div><p class="muted mx-auto mt-5 max-w-md text-sm leading-7">No portrait or location data is published until consent and metadata checks pass.</p></div></div></section></BaseLayout>
