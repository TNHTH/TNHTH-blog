---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { statusLabel } from "../../../config/site";
import { relatedNotesForProject } from "../../lib/content";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const notes = await getCollection("notes");
const relatedNotes = relatedNotesForProject(entry.id, notes);
const status = statusLabel[entry.data.status];
const imageEvidence = entry.data.evidence.find((item) => item.kind === "image");
const metrics = entry.data.evidence.filter((item) => item.kind === "metric");
---
<BaseLayout title={entry.data.title} description={entry.data.outcome} ogImage={imageEvidence?.src} ogImageAlt={imageEvidence?.alt}>
  <article class="site-shell mx-auto pt-14 md:pt-20">
    <div class="eyebrow">项目 · {status}</div>
    <div class="mt-5 grid gap-8 md:grid-cols-[1fr_260px] md:items-end">
      <div><h1 class="display m-0 max-w-4xl text-5xl leading-tight md:text-7xl">{entry.data.title}</h1><p class="muted mt-6 max-w-2xl text-xl leading-9">{entry.data.outcome}</p></div>
      <div class="text-base leading-8"><div>{entry.data.period}</div>{entry.data.role && <div class="muted">{entry.data.role}</div>}<div class="mt-4 flex flex-wrap gap-4">{entry.data.repo && <a class="focus-ring underline" href={entry.data.repo} target="_blank" rel="noreferrer" aria-label={`${entry.data.title} · GitHub 项目源码`}>GitHub → 项目源码</a>}{entry.data.demo && <a class="focus-ring underline" href={entry.data.demo} target="_blank" rel="noreferrer" aria-label={`${entry.data.title} · 在线演示`}>Demo → 在线演示</a>}</div></div>
    </div>

    {entry.data.evidence.length > 0 && <section class="mt-14 border-y border-[var(--line)] py-8" aria-labelledby="evidence-title">
      <div class="eyebrow" id="evidence-title">成果证据</div>
      <div class="mt-5 grid gap-4 md:grid-cols-2">{entry.data.evidence.map((item) => (
        <div class="border border-[var(--line)] p-5">
          {item.kind === "image" ? (
            <figure class="m-0">
              <Image src={item.src} alt={item.alt} width={960} class="h-auto w-full rounded-md" />
              <figcaption class="muted mt-2 text-sm">{item.label}</figcaption>
            </figure>
          ) : item.kind === "metric" ? (
            <>
              <strong>{item.label}</strong>
              <p class="muted mt-2 font-mono text-sm">{item.value}</p>
            </>
          ) : item.kind === "document" ? (
            <>
              <strong>{item.label}</strong>
              {item.value && <p class="muted mt-2 font-mono text-sm">{item.value}</p>}
              {item.href && <a class="focus-ring mt-3 inline-block underline" href={item.href} target="_blank" rel="noreferrer">查看证据 →</a>}
            </>
          ) : item.kind === "demo" ? (
            <>
              <strong>{item.label}</strong>
              <a class="focus-ring mt-3 inline-block underline" href={item.href} target="_blank" rel="noreferrer">查看证据 →</a>
            </>
          ) : (
            <>
              <strong>{item.label}</strong>
              <a class="focus-ring mt-3 inline-block underline" href={item.href} target="_blank" rel="noreferrer">查看证据 →</a>
            </>
          )}
        </div>
      ))}</div>
    </section>}

    {metrics.length > 0 && <section class="mt-14 border-t border-[var(--line)] pt-7" aria-labelledby="results-title"><div class="eyebrow" id="results-title">结果</div><div class="mt-5 grid gap-4 md:grid-cols-3">{metrics.map((item) => <div><div class="display text-3xl">{item.value ?? item.label}</div><div class="muted mt-2 text-sm">{item.label}</div></div>)}</div></section>}
    {entry.data.contributions.length > 0 && <section class="mt-14 grid gap-8 border-t border-[var(--line)] pt-7 md:grid-cols-[1fr_2fr]" aria-labelledby="contributions-title"><div class="eyebrow" id="contributions-title">我的贡献</div><ul class="m-0 grid gap-3 pl-5 text-base leading-8">{entry.data.contributions.map((item) => <li>{item}</li>)}</ul></section>}
    <section class="mt-12 grid gap-8 border-t border-[var(--line)] pt-7 md:grid-cols-[1fr_2fr]" aria-labelledby="overview-title"><div class="eyebrow" id="overview-title">系统概览</div><div class="min-w-0"><div class="prose max-w-3xl leading-8"><Content /></div>{entry.data.tech.length > 0 && <div class="mt-8 flex flex-wrap gap-2">{entry.data.tech.map((item) => <span class="tag">{item}</span>)}</div>}</div></section>
    {relatedNotes.length > 0 && <section class="mt-16 border-t border-[var(--line)] pt-7" aria-labelledby="related-notes-title"><div class="eyebrow" id="related-notes-title">关联笔记</div><div class="mt-5 grid gap-3">{relatedNotes.map((note) => <a class="focus-ring border-b border-[var(--line)] py-4" href={`/notes/${note.id}`}><strong>{note.data.title}</strong>{note.data.summary && <span class="muted ml-3">{note.data.summary}</span>}</a>)}</div></section>}
  </article>
</BaseLayout>
